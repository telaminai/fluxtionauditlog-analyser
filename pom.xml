<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.telamin</groupId>
    <artifactId>fluxtion-auditlog-analyser</artifactId>
    <!-- placeholder: real versions are stamped by the release workflow (mvn versions:set); master stays here -->
    <version>0.0.0-SNAPSHOT</version>

    <organization>
        <name>Telamin Limited</name>
    </organization>

    <licenses>
        <license>
            <name>Telamin Source-Available License 1.0 (Non-Production)</name>
            <url>https://github.com/telaminai/fluxtionauditlog-analyser/blob/master/LICENSE</url>
            <distribution>manual</distribution>
            <comments>Source-available; Development Use only — Production Use requires a commercial license.</comments>
        </license>
    </licenses>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
    </properties>

    <!-- One UI dependency: FlatLaf (MIT, pure-Java, modern flat themes). JUnit is test scope only. -->
    <dependencies>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.5.1</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- ship the changelog inside the jar so Help ▸ Release notes and the what's-new dialog
                 read the same notes as the GitHub release (M16 §7) -->
            <resource>
                <directory>${project.basedir}</directory>
                <includes>
                    <include>CHANGELOG.md</include>
                </includes>
                <targetPath>release-notes</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- Zero runtime deps, so a plain jar with a Main-Class manifest is runnable via java -jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>telamin.fluxtion.audit.analyser.Main</mainClass>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- Bundle FlatLaf into a runnable uber-jar so `java -jar` works standalone. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>telamin.fluxtion.audit.analyser.Main</mainClass>
                                    <!-- the fat jar's manifest is the one the app reads at runtime -->
                                    <manifestEntries>
                                        <Implementation-Title>Fluxtion Audit Log Analyser</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
