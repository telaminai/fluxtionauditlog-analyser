# MkDocs docs site builds to target/docs-site (covered by the target/ ignore above)
# Local docs toolchain venv (Homebrew python is PEP 668 externally-managed, so pip needs a venv):
#   python3 -m venv .venv && .venv/bin/pip install -r docs-requirements.txt
.venv/

# JetBrains Junie local agent state
.junie/
!.junie/guidelines.md

# fixture generator build output (the generated processor is a build artefact, not source)
examples/*/target/

# Python bytecode (tools/bench, tools/spikes)
__pycache__/
*.pyc

# M44: the AOT generator also emits a PNG of the graph next to the GraphML. It is 232 KB of jar for a
# picture nothing reads at runtime, and rule 1's sweep cannot see inside an image — so it is regenerated,
# never committed. The GraphML beside it is the reviewable artefact and IS committed.
src/main/resources/**/generated/*.png

# generated processors are build output and carry a vendor-domain copyright header,
# which the rule-1 sweep cannot see inside but does match. never commit them.
docs/experience/current/*/src/main/java/com/acme/app/generated/
docs/experience/current/*/src/main/resources/com/acme/app/generated/

# generated build output: the Fluxtion generator stamps a vendor-domain copyright header
# (repo rule 1), and it emits a .png the sweep cannot read. Never track it.
docs/experience/artifacts/*/src/main/resources/com/acme/generated/
docs/experience/artifacts/*/src/main/java/com/acme/generated/
docs/experience/artifacts/*/target/

# Round 54 benchmark: Fluxtion-generated sources carry an upstream copyright header
# whose domain is a sweep term (rule 1). Regenerate with gen/Gen.java, never commit.
docs/experience/runs/round-54/generated/
docs/experience/runs/round-54/generated2/
docs/experience/runs/round-54/reach/
docs/experience/runs/round-54/reach2/
