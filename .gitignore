### Mac OS ###
.DS_Store
# MkDocs docs site builds to target/docs-site (covered by the target/ ignore above)
# Local docs toolchain venv (Homebrew python is PEP 668 externally-managed, so pip needs a venv):
#   python3 -m venv .venv && .venv/bin/pip install -r docs-requirements.txt
.venv/

# JetBrains Junie local agent state
.junie/
!.junie/guidelines.md

# fixture generator build output (the generated processor is a build artefact, not source)
examples/*/target/

# Python bytecode (tools/bench, tools/spikes)
__pycache__/
*.pyc

# M44: the AOT generator also emits a PNG of the graph next to the GraphML. It is 232 KB of jar for a
# picture nothing reads at runtime, and rule 1's sweep cannot see inside an image — so it is regenerated,
# never committed. The GraphML beside it is the reviewable artefact and IS committed.
src/main/resources/**/generated/*.png
