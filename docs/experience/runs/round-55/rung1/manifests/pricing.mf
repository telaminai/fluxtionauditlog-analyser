Fluxtion-Convention: spread=capped

Name: com/vendor/pricing/PricingSmoothed.class
Fluxtion-Entry-Point: true
Fluxtion-Provides: adjusted=AdjustedApi, spread=SpreadApi
Fluxtion-Requires: MidApi, DepthApi
