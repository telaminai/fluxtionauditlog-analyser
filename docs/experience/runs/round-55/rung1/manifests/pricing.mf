Implementation-Title: pricing
Fluxtion-Component: true

Name: com/vendor/pricing/PricingSpot.class
Fluxtion-Entry-Point: true
Fluxtion-Provides: adjusted=AdjustedApi
Fluxtion-Requires: MidApi, DepthApi
Fluxtion-Constructor: (MidApi, DepthApi)
Fluxtion-Description: the adjusted price only

Name: com/vendor/pricing/PricingFull.class
Fluxtion-Entry-Point: true
Fluxtion-Provides: adjusted=AdjustedApi, spread=SpreadApi
Fluxtion-Requires: MidApi, DepthApi
Fluxtion-Constructor: (MidApi, DepthApi)
Fluxtion-Consumes: Rate
Fluxtion-Description: adds the spread; owns the RATE event
Fluxtion-Convention: spread=raw

Name: com/vendor/pricing/PricingHedged.class
Fluxtion-Entry-Point: true
