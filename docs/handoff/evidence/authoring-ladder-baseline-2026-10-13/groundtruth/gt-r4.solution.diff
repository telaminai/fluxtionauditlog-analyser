+package com.example.myapp.node;
+
+public class VwapCalc extends com.telamin.fluxtion.runtime.audit.EventLogNode {
+
+    public VwapCalc(com.example.myapp.node.TradeIntake arg0) {
+        this.tradeIntake = arg0;
+    }
+
+    // This reference's propagation mode is declared in the XML; it does not make the referenced object immutable. See https://fluxtion-playground.dev/spring-authoring/contract.md#local-authoring-workflow-and-extended-declarations
+    private final com.example.myapp.node.TradeIntake tradeIntake;
+    // node-local state, not a graph reference: transient keeps Fluxtion from treating it as one (FLX-1009)
+    private final transient java.util.Map<String, java.util.ArrayDeque<double[]>> windows = new java.util.HashMap<>();
+
+    // Publish output according to the declared sink and value-type contract. See https://fluxtion-playground.dev/spring-authoring/contract.md#local-authoring-workflow-and-extended-declarations
+    @javax.annotation.processing.Generated("fluxtion-starter")
+    public com.telamin.fluxtion.runtime.output.SinkPublisher<com.example.myapp.event.VwapUpdate> sinkVwap = new com.telamin.fluxtion.runtime.output.SinkPublisher<>("vwap");
+
+    // Implement this event callback according to the XML declaration and callback return contract. See https://fluxtion-playground.dev/spring-authoring/contract.md#local-authoring-workflow-and-extended-declarations
+    @com.telamin.fluxtion.runtime.annotations.OnEventHandler(filterString = "clear")
+    @javax.annotation.processing.Generated("fluxtion-starter")
+    public boolean onSignalClear(com.telamin.fluxtion.runtime.event.Signal<?> event) {
+        auditLog.info("handledEvent", event.getClass().getName());
+        if ((Object) event instanceof com.telamin.fluxtion.runtime.event.Event) {
+            com.telamin.fluxtion.runtime.event.Event auditEvent = (com.telamin.fluxtion.runtime.event.Event) (Object) event;
+            if (auditEvent.filterId() != com.telamin.fluxtion.runtime.event.Event.NO_INT_FILTER)
+                auditLog.info("filterId", auditEvent.filterId());
+            if (auditEvent.filterString() != null && !auditEvent.filterString().isEmpty())
+                auditLog.info("filterString", auditEvent.filterString().replace('\r', ' ').replace('\n', ' ').replaceAll("[^a-zA-Z0-9_. /@+-]", "_"));
+        }
+        windows.clear();
+        auditLog.info("cleared", true);
+        return false;  // clearing publishes nothing
+    }
+
+    // Implement this trigger callback according to the XML declaration and callback return contract. See https://fluxtion-playground.dev/spring-authoring/contract.md#local-authoring-workflow-and-extended-declarations
+    @com.telamin.fluxtion.runtime.annotations.OnTrigger
+    @javax.annotation.processing.Generated("fluxtion-starter")
+    public boolean onVwapCalc() {
+        auditLog.info("triggerFired", true);
+        com.example.myapp.event.Trade t = tradeIntake.lastTrade();
+        var w = windows.computeIfAbsent(t.symbol(), k -> new java.util.ArrayDeque<>());
+        w.addLast(new double[]{t.price(), t.qty()});
+        if (w.size() > 3) w.removeFirst();
+        double pv = 0, q = 0;
+        for (double[] x : w) { pv += x[0] * x[1]; q += x[1]; }
+        double vwap = pv / q;
+        auditLog.info("symbol", t.symbol());
+        auditLog.info("vwap", vwap);
+        sinkVwap.publish(new com.example.myapp.event.VwapUpdate(t.symbol(), vwap));
+        return true;
+    }
+}
