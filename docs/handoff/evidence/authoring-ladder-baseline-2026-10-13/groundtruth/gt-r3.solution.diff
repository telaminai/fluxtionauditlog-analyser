+package com.example.myapp.service;
+
+/** A TradeLimits configured in server-config.yml. */
+public class FixedTradeLimits implements TradeLimits {
+    private double limit;
+
+    public double getLimit() { return limit; }
+    public void setLimit(double limit) { this.limit = limit; }
+
+    @Override
+    public double largeTradeLimit() { return limit; }
+}
