+package com.example.myapp.node;
+
+public class AlertCounter extends com.telamin.fluxtion.runtime.audit.EventLogNode {
+
+    public AlertCounter(com.example.myapp.node.LargeTradeFlag arg0) {
+        this.largeTradeFlag = arg0;
+    }
+
+    // This reference's propagation mode is declared in the XML; it does not make the referenced object immutable. See https://fluxtion-playground.dev/spring-authoring/contract.md#local-authoring-workflow-and-extended-declarations
+    private final com.example.myapp.node.LargeTradeFlag largeTradeFlag;
+    private int alerts;
+
+    // Implement this trigger callback according to the XML declaration and callback return contract. See https://fluxtion-playground.dev/spring-authoring/contract.md#local-authoring-workflow-and-extended-declarations
+    @com.telamin.fluxtion.runtime.annotations.OnTrigger
+    @javax.annotation.processing.Generated("fluxtion-starter")
+    public boolean onAlertCounter() {
+        auditLog.info("triggerFired", true);
+        alerts++;
+        auditLog.info("alerts", alerts);
+        return true;
+    }
+}
diff -ruN fixture/src/main/java/com/example/myapp/node/LargeTradeFlag.java gt/src/main/java/com/example/myapp/node/LargeTradeFlag.java
--- fixture/src/main/java/com/example/myapp/node/LargeTradeFlag.java	1970-01-01 01:00:00
+++ gt/src/main/java/com/example/myapp/node/LargeTradeFlag.java	2026-10-13 13:13:51
@@ -0,0 +1,35 @@
+package com.example.myapp.node;
+
+public class LargeTradeFlag extends com.telamin.fluxtion.runtime.audit.EventLogNode {
+
+    public LargeTradeFlag(com.example.myapp.node.RiskCheck arg0) {
+        this.riskCheck = arg0;
+    }
+
+    // This reference's propagation mode is declared in the XML; it does not make the referenced object immutable. See https://fluxtion-playground.dev/spring-authoring/contract.md#local-authoring-workflow-and-extended-declarations
+    private final com.example.myapp.node.RiskCheck riskCheck;
+
+    private com.example.myapp.service.TradeLimits tradeLimits;
+
+    // Implement this trigger callback according to the XML declaration and callback return contract. See https://fluxtion-playground.dev/spring-authoring/contract.md#local-authoring-workflow-and-extended-declarations
+    @com.telamin.fluxtion.runtime.annotations.OnTrigger
+    @javax.annotation.processing.Generated("fluxtion-starter")
+    public boolean onLargeTradeFlag() {
+        auditLog.info("triggerFired", true);
+        if (!(riskCheck.getLatestEvent() instanceof com.example.myapp.event.PriceEvent trade)) return false;
+        double notional = trade.price() * trade.volume();
+        boolean large = tradeLimits != null && notional > tradeLimits.largeTradeLimit();
+        auditLog.info("symbol", trade.symbol());
+        auditLog.info("notional", notional);
+        auditLog.info("large", large);
+        return large;  // AlertCounter runs only for a large trade
+    }
+
+    // Implement registration handling according to the declared service contract. See https://fluxtion-playground.dev/spring-authoring/contract.md#local-authoring-workflow-and-extended-declarations
+    @com.telamin.fluxtion.runtime.annotations.runtime.ServiceRegistered(value = "tradeLimits")
+    @javax.annotation.processing.Generated("fluxtion-starter")
+    public void tradeLimits(com.example.myapp.service.TradeLimits event) {
+        this.tradeLimits = event;
+        auditLog.info("limit", event.largeTradeLimit());
+    }
+}
