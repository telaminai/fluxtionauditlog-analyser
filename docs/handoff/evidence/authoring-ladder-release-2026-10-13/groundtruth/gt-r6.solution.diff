diff -ruN fixture/src/main/java/com/example/myapp/node/TurnoverTracker.java gt/src/main/java/com/example/myapp/node/TurnoverTracker.java
--- fixture/src/main/java/com/example/myapp/node/TurnoverTracker.java	1970-01-01 01:00:00
+++ gt/src/main/java/com/example/myapp/node/TurnoverTracker.java	2026-10-13 21:51:12
@@ -0,0 +1,39 @@
+package com.example.myapp.node;
+
+public class TurnoverTracker extends com.telamin.fluxtion.runtime.audit.EventLogNode {
+
+    public TurnoverTracker(com.example.myapp.node.RootNode arg0, com.example.myapp.node.RiskCheck arg1, com.example.myapp.node.CsvRejections arg2) {
+        this.rootNode = arg0;
+        this.riskCheck = arg1;
+        this.csvRejections = arg2;
+    }
+
+    // This reference's propagation mode is declared in the XML; it does not make the referenced object immutable. See https://fluxtion-playground.dev/spring-authoring/contract.md#local-authoring-workflow-and-extended-declarations
+    private final com.example.myapp.node.RootNode rootNode;
+
+    // This reference's propagation mode is declared in the XML; it does not make the referenced object immutable. See https://fluxtion-playground.dev/spring-authoring/contract.md#local-authoring-workflow-and-extended-declarations
+    private final com.example.myapp.node.RiskCheck riskCheck;
+
+    // This reference's propagation mode is declared in the XML; it does not make the referenced object immutable. See https://fluxtion-playground.dev/spring-authoring/contract.md#local-authoring-workflow-and-extended-declarations
+    @com.telamin.fluxtion.runtime.annotations.NoTriggerReference
+    private final com.example.myapp.node.CsvRejections csvRejections;
+
+    // Publish output according to the declared sink and value-type contract. See https://fluxtion-playground.dev/spring-authoring/contract.md#local-authoring-workflow-and-extended-declarations
+    @javax.annotation.processing.Generated("fluxtion-starter")
+    public com.telamin.fluxtion.runtime.output.SinkPublisher<java.lang.Object> sinkTurnover = new com.telamin.fluxtion.runtime.output.SinkPublisher<>("turnover");
+
+    // Implement this trigger callback according to the XML declaration and callback return contract. See https://fluxtion-playground.dev/spring-authoring/contract.md#local-authoring-workflow-and-extended-declarations
+    @com.telamin.fluxtion.runtime.annotations.OnTrigger
+    @javax.annotation.processing.Generated("fluxtion-starter")
+    public boolean onTurnoverTracker() {
+        auditLog.info("triggerFired", true);
+        if (!(riskCheck.getLatestEvent() instanceof com.example.myapp.event.PriceEvent e)) return false;
+        double notional = e.price() * e.volume();
+        long rejected = csvRejections.getRejectedCount();
+        auditLog.info("symbol", e.symbol());
+        auditLog.info("notional", notional);
+        auditLog.info("rejectedSoFar", rejected);
+        sinkTurnover.publish(e.symbol() + "," + notional + "," + rejected);
+        return true;
+    }
+}
