<?xml version="1.0" encoding="UTF-8"?>
<!-- fluxtion-builder -->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           https://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Topology declaration. Each <bean> becomes a Fluxtion node; a <constructor-arg
         ref="..."/> becomes a Fluxtion dependency edge. Generated by the Fluxtion
         project starter — the referenced classes live in src/main/java. -->
    <bean id="marketDataNode" class="com.example.myapp.node.MarketDataNode"/>
    <bean id="volatilityCalc" class="com.example.myapp.node.VolatilityCalc">
        <constructor-arg ref="marketDataNode"/>
    </bean>
    <bean id="sentimentCalc" class="com.example.myapp.node.SentimentCalc">
        <constructor-arg ref="marketDataNode"/>
    </bean>
    <bean id="riskEngine" class="com.example.myapp.node.RiskEngine">
        <constructor-arg ref="volatilityCalc"/>
        <constructor-arg ref="sentimentCalc"/>
    </bean>
    <bean id="orderGate" class="com.example.myapp.node.OrderGate">
        <constructor-arg ref="marketDataNode"/>
        <constructor-arg ref="riskEngine"/>
    </bean>

    <!-- Fluxtion semantic config: explicit graph nodes, event input contract,
         optional handler expectations, and audit/auditor settings. -->
    <bean id="alertNode" class="com.example.myapp.node.AlertNode">
        <constructor-arg ref="riskEngine"/>
    </bean>
    <bean id="fluxtionSpringConfig" class="com.telamin.fluxtion.builder.extern.spring.FluxtionSpringConfig">
        <property name="nodeBeans">
            <list>
                <value>marketDataNode</value>
                <value>volatilityCalc</value>
                <value>sentimentCalc</value>
                <value>riskEngine</value>
                <value>orderGate</value>
                <value>alertNode</value>
            </list>
        </property>
        <property name="eventTypes">
            <list>
                <value>com.example.myapp.event.PriceTick</value>
                <value>com.example.myapp.event.OrderEvent</value>
                <value>com.example.myapp.event.NewsEvent</value>
            </list>
        </property>
        <property name="eventHandlers">
            <list>
                <bean class="com.telamin.fluxtion.builder.extern.spring.FluxtionSpringConfig.EventHandlerBinding"><property name="event" value="com.example.myapp.event.NewsEvent"/><property name="nodeBeans"><list><value>alertNode</value></list></property></bean>
                <bean class="com.telamin.fluxtion.builder.extern.spring.FluxtionSpringConfig.EventHandlerBinding">
                    <property name="event" value="com.example.myapp.event.PriceTick"/>
                    <property name="nodeBeans">
                        <list>
                            <value>marketDataNode</value>
                        </list>
                    </property>
                </bean>
                <bean class="com.telamin.fluxtion.builder.extern.spring.FluxtionSpringConfig.EventHandlerBinding">
                    <property name="event" value="com.example.myapp.event.OrderEvent"/>
                    <property name="nodeBeans">
                        <list>
                            <value>marketDataNode</value>
                            <value>orderGate</value>
                        </list>
                    </property>
                </bean>
                <bean class="com.telamin.fluxtion.builder.extern.spring.FluxtionSpringConfig.EventHandlerBinding">
                    <property name="event" value="com.example.myapp.event.NewsEvent"/>
                    <property name="nodeBeans">
                        <list>
                            <value>marketDataNode</value>
                            <value>sentimentCalc</value>
                        </list>
                    </property>
                </bean>
            </list>
        </property>
        <property name="logLevel" value="INFO"/>
    </bean>

</beans>
