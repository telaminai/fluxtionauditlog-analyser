            </data>
        </edge>
        <edge id="13" source="ServiceListener" target="serviceRegistry">
            <data key="edge_label">
                <jGraph:ShapeEdge/>
            </data>
        </edge>
        <edge id="14" source="EventLogControlEvent" target="eventLogger">
            <data key="edge_label">
                <jGraph:ShapeEdge/>
            </data>
        </edge>
    </graph>
</graphml>
