<?xml version="1.0" encoding="UTF-8"?><graphml xmlns="http://graphml.graphdrawing.org/xmlns" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd" xmlns:jGraph="http://www.jgraph.com/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <key id="vertex_label" for="node" attr.name="nodeData" attr.type="string"/>
    <key id="edge_label" for="edge" attr.name="edgeData" attr.type="string"/>
    <graph edgedefault="undirected">
        <node id="clock">
            <data key="vertex_label">
                <jGraph:ShapeNode>
                    <jGraph:Geometry height="70" width="160" x="20" y="20"/>
                    <jGraph:label text="&lt;&lt;EventHandle&gt;&gt;&#10;id:clock&#10;class:com.telamin.fluxtion.runtime.time.Clock"/>
                    <jGraph:Style properties="EVENTHANDLER"/>
                </jGraph:ShapeNode>
            </data>
        </node>
        <node id="marketDataEvent">
            <data key="vertex_label">
                <jGraph:ShapeNode>
                    <jGraph:Geometry height="70" width="160" x="20" y="20"/>
                    <jGraph:label text="id:marketDataEvent&#10;class:com.acme.demo.api.MarketDataEvent"/>
                    <jGraph:Style properties="EVENT"/>
                </jGraph:ShapeNode>
            </data>
        </node>
        <node id="priceListener_2">
            <data key="vertex_label">
                <jGraph:ShapeNode>
                    <jGraph:Geometry height="70" width="160" x="20" y="20"/>
                    <jGraph:label text="&lt;&lt;EventHandle&gt;&gt;&#10;id:priceListener_2&#10;class:com.acme.demo.node.PriceListener"/>
                    <jGraph:Style properties="EVENTHANDLER"/>
                </jGraph:ShapeNode>
            </data>
        </node>
        <node id="midPriceCalculator_1">
            <data key="vertex_label">
                <jGraph:ShapeNode>
                    <jGraph:Geometry height="70" width="160" x="20" y="20"/>
                    <jGraph:label text="id:midPriceCalculator_1&#10;class:com.acme.demo.node.MidPriceCalculator$Inner"/>
                    <jGraph:Style properties="NODE"/>
                </jGraph:ShapeNode>
            </data>
        </node>
        <node id="positionCalculator_0">
            <data key="vertex_label">
                <jGraph:ShapeNode>
                    <jGraph:Geometry height="70" width="160" x="20" y="20"/>
                    <jGraph:label text="id:positionCalculator_0&#10;class:com.acme.demo.node.PositionCalculator"/>
                    <jGraph:Style properties="NODE"/>
                </jGraph:ShapeNode>
            </data>
        </node>
        <node id="quotePublisher_3">
            <data key="vertex_label">
                <jGraph:ShapeNode>
                    <jGraph:Geometry height="70" width="160" x="20" y="20"/>
                    <jGraph:label text="id:quotePublisher_3&#10;class:com.acme.demo.node.QuotePublisher"/>
                    <jGraph:Style properties="EXPORTSERVICE"/>
                </jGraph:ShapeNode>
            </data>
        </node>
        <node id="unstyledNode_9">
            <data key="vertex_label">
                <jGraph:ShapeNode>
                    <jGraph:Geometry height="70" width="160" x="20" y="20"/>
                    <jGraph:label text="id:unstyledNode_9"/>
                </jGraph:ShapeNode>
            </data>
        </node>
        <edge id="1" source="marketDataEvent" target="priceListener_2">
            <data key="edge_label">
                <jGraph:ShapeEdge/>
            </data>
        </edge>
        <edge id="2" source="priceListener_2" target="midPriceCalculator_1">
            <data key="edge_label">
                <jGraph:ShapeEdge/>
            </data>
        </edge>
        <edge id="3" source="midPriceCalculator_1" target="positionCalculator_0">
            <data key="edge_label">
                <jGraph:ShapeEdge/>
            </data>
        </edge>
        <edge id="4" source="priceListener_2" target="positionCalculator_0">
            <data key="edge_label">
                <jGraph:ShapeEdge/>
            </data>
        </edge>
        <edge id="5" source="positionCalculator_0" target="quotePublisher_3">
            <data key="edge_label">
                <jGraph:ShapeEdge/>
            </data>
        </edge>
    </graph>
</graphml>
