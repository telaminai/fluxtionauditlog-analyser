<?xml version="1.0" encoding="UTF-8"?>
<!--
  Standalone: deliberately NOT a module of the analyser build. It exists to regenerate test fixtures and
  pulls the Fluxtion compiler in to do it — the analyser itself keeps FlatLaf as its only runtime
  dependency, and CI must not start resolving a compiler to run unit tests.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.acme</groupId>
    <artifactId>fixture-generator</artifactId>
    <version>1.0</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <fluxtion.version>9.7.14</fluxtion.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fluxtion</groupId>
            <artifactId>compiler</artifactId>
            <version>${fluxtion.version}</version>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <!--
              Forks a JVM (exec, not java): Fluxtion compiles the generated processor in-process with
              javac, which needs a real classpath. The in-process 'java' goal hands it an isolated
              classloader instead and generation fails on "package com.fluxtion.runtime does not exist".
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.1</version>
                <configuration>
                    <executable>java</executable>
                    <arguments>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>com.acme.demo.GenerateFixtures</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
